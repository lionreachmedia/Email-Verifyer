# ════════════════════════════════════════════════════════════════════
#  MailGuard server settings. Copy to server/.env and fill in.
#  Never commit server/.env — it holds secrets.
# ════════════════════════════════════════════════════════════════════

# ── Basics ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Where the React app runs. In production with SERVE_CLIENT=true this is your public URL.
CLIENT_URL=http://localhost:5173
# Production: let this server also serve the built React app (one process, one domain).
SERVE_CLIENT=false
# Behind Nginx/Cloudflare/Coolify? Set to 1 so rate limits see real visitor IPs.
TRUST_PROXY=0

# ── Databases ───────────────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/mailguard
REDIS_URL=redis://127.0.0.1:6379

# ── Login sessions ──────────────────────────────────────────────────
# REQUIRED. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRE=7d

# ── Outgoing email (sign-up codes, password resets) ─────────────────
# Leave empty in development: codes are printed in the server console instead.
# Gmail: use an App Password (Google Account → Security → App passwords), not your normal password.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=MailGuard

# Free credits for new accounts
SIGNUP_CREDITS=100

# ════════════════════════════════════════════════════════════════════
#  MAILBOX-CHECK APIs — this is what decides result quality
# ════════════════════════════════════════════════════════════════════
# Comma-separated, tried in order. The first API that gives a definite
# answer wins; "unknown", errors and "out of credits" fall through to the next.
# Options: reoon, zerobounce, emailable, kickbox, hunter, reacher
# Examples:
#   One API:                         reoon
#   Fallback when credits run out:   reoon,zerobounce
VERIFY_PROVIDERS=reoon

# Reoon Email Verifier — key from emailverifier.reoon.com → API
REOON_API_KEY=
# power = checks the real mailbox (recommended). quick = syntax/domain only (MailGuard already does that for free).
REOON_MODE=power

ZEROBOUNCE_API_KEY=
EMAILABLE_API_KEY=
KICKBOX_API_KEY=
HUNTER_API_KEY=
REACHER_API_KEY=
# Only for a self-hosted Reacher backend (leave empty when using REACHER_API_KEY)
REACHER_URL=
REACHER_SECRET=
PROVIDER_TIMEOUT_MS=30000

# How long a definite result is reused before checking again (saves API credits)
VERIFY_CACHE_TTL_HOURS=72

# ── Bulk processing ─────────────────────────────────────────────────
BULK_MAX_EMAILS=100000
BULK_BATCH_SIZE=25
# Batches processed at the same time, and emails per batch at the same time.
# Keep these modest so you stay inside your API provider's rate limit.
WORKER_CONCURRENCY=2
WORKER_EMAIL_CONCURRENCY=4
# Set true to run the worker inside the API process (simple single-process deploys).
RUN_WORKER=false
